{
  "$schema": "./RelationshipPatternsSchema.json",
  "version": "2.0",
  "description": "Relationship extraction patterns for PatternBasedRelationshipExtractor",
  "lastUpdated": "2025-01-15",
  "patterns": [
    {
  "name": "FoundedByPassive",
      "regex": "\\b(founded\\s+by|established\\s+by|created\\s+by|started\\s+by|encouraged.*?by|set\\s+up\\s+by)\\b",
 "relationshipType": "Founded",
  "confidence": 0.95,
      "isDirectional": false,
    "description": "Passive voice founded relationships (e.g., 'Society founded by Professor')",
      "examples": [
        "The Plinian Society was founded by Professor Jameson",
        "The company was established by John Smith"
      ],
      "category": "Organizational"
    },
    {
      "name": "FoundedActive",
      "regex": "\\b(founded|established|created|started|formed|set\\s+up)\\b",
      "relationshipType": "Founded",
      "confidence": 0.95,
      "isDirectional": true,
      "description": "Active voice founded relationships",
      "examples": [
        "Professor Jameson founded the Society",
        "She established the company in 2020"
      ],
      "category": "Organizational"
    },
    {
      "name": "StudiedAt",
      "regex": "\\b(sent.*?to|went\\s+to|studied\\s+at|enrolled\\s+(at|in)|attended|stayed\\s+at|spent.*?(sessions?|years?|time)\\s+(at|in))\\b",
      "relationshipType": "StudiedAt",
      "confidence": 0.9,
  "isDirectional": true,
      "description": "Educational institution attendance",
      "examples": [
        "Darwin studied at Edinburgh University",
        "She went to Cambridge",
        "He spent two years at Oxford"
      ],
      "category": "Educational"
    },
    {
      "name": "MentorOf",
      "regex": "\\b(mentored|taught|guided|advised|persuaded\\s+me|asked.*?to|recommended.*?for|encouraged\\s+me)\\b",
      "relationshipType": "MentorOf",
      "confidence": 0.85,
  "isDirectional": true,
   "description": "Mentorship and guidance relationships",
      "examples": [
        "Henslow mentored Darwin",
        "Professor Smith guided me through my research"
      ],
      "category": "Educational"
    },
    {
      "name": "PresentedTo",
      "regex": "\\b(read\\s+(before|to)|presented\\s+(to|at)|delivered.*?(to|at)|gave.*?paper\\s+(to|at))\\b",
      "relationshipType": "PresentedTo",
      "confidence": 0.85,
      "isDirectional": true,
      "description": "Academic presentation relationships",
"examples": [
        "Darwin read a paper before the Plinian Society",
 "She presented her findings to the committee"
   ],
      "category": "Academic"
 },
    {
      "name": "TraveledOn",
 "regex": "\\b(voyage|journey|expedition|trip|traveled|sailed)\\s+(of|on|aboard|in)\\s+(the\\s+)?['\"\"]?\\b",
      "relationshipType": "TraveledOn",
      "confidence": 0.9,
      "isDirectional": true,
      "description": "Travel and transportation relationships",
  "examples": [
        "Darwin traveled on HMS Beagle",
      "The voyage of the Discovery"
      ],
      "category": "Travel"
    },
    {
      "name": "WorksAtUniversity",
      "regex": "\\b((Professor|Dr\\.|Doctor)\\s+\\w+\\s+(at|of)|at\\s+(the\\s+)?\\w+\\s+(University|College|Institute))\\b",
   "relationshipType": "WorksFor",
      "confidence": 0.9,
      "isDirectional": true,
      "description": "Academic employment at institutions",
      "examples": [
        "Professor Jameson at Edinburgh University",
        "Dr. Smith of Cambridge"
      ],
      "category": "Employment"
    },
    {
      "name": "MemberOf",
      "regex": "\\b(member\\s+of|belonged\\s+to|part\\s+of|joined|attended\\s+meetings|participated\\s+in)\\b",
      "relationshipType": "MemberOf",
      "confidence": 0.9,
    "isDirectional": true,
      "description": "Organizational membership",
      "examples": [
  "Darwin was a member of the Royal Society",
 "She belonged to the academic committee"
      ],
  "category": "Organizational"
    },
    {
      "name": "LocatedIn",
      "regex": "\\b(at|in|located\\s+in|based\\s+in|from|situated\\s+in)\\b",
      "relationshipType": "LocatedIn",
      "confidence": 0.85,
"isDirectional": true,
      "description": "Geographic location relationships",
    "examples": [
      "Edinburgh University in Scotland",
        "The lab is located in Cambridge"
      ],
      "category": "Geographic"
    },
    {
      "name": "WorksFor",
      "regex": "\\b(works?\\s+for|worked\\s+for|employed\\s+by|works?\\s+at|serves?\\s+at)\\b",
      "relationshipType": "WorksFor",
 "confidence": 0.9,
      "isDirectional": true,
    "description": "Employment relationships",
      "examples": [
   "She works for the company",
        "He was employed by the university"
      ],
      "category": "Employment"
    },
    {
      "name": "AuthorOf",
      "regex": "\\b(wrote|authored|created|composed|published)\\b",
      "relationshipType": "AuthorOf",
      "confidence": 0.9,
      "isDirectional": true,
